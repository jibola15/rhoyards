# Copy to apps/api/.env and fill in. Never commit the real .env file.

NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Comma-separated browser origins allowed to call the API with credentials.
# In development the Vite dev servers proxy /api, so these are only needed for direct calls.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Number of reverse-proxy hops to trust for client IPs (0 = none, 1 = one load balancer).
TRUST_PROXY=0

# Serve Swagger UI at /api/docs and the spec at /api/openapi.json.
# Defaults to on outside production and off in production; leave unset in production.
# API_DOCS_ENABLED=true

# --- Database (Neon PostgreSQL) — required from Phase 2 ---
# Pooled connection string (host contains "-pooler"), used by the running API.
# DATABASE_URL="postgresql://<app_role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/rhoyards?sslmode=require"
# Direct (non-pooled) connection string, used only for migrations.
# DIRECT_URL="postgresql://<migration_role>:<password>@<endpoint>.<region>.aws.neon.tech/rhoyards?sslmode=require"

# --- Automated tests ---
# A SEPARATE DATABASE whose name contains "test" (e.g. CREATE DATABASE rhoyards_test;). The suite truncates it.
# Do not isolate tests with ?schema= : behind Neon's PgBouncer pooler the search_path can leak between
# pooled connections, so tests could truncate development data.
# TEST_DATABASE_URL="postgresql://...-pooler.../rhoyards_test?sslmode=require&pgbouncer=true"
# TEST_DIRECT_URL="postgresql://.../rhoyards_test?sslmode=require"

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOGIN_RATE_LIMIT=10

# Uploaded files (local disk driver). Relative paths resolve from apps/api. Git-ignored.
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=5
# IANA time zone that defines the business day (journal dates of sales and shift closes)
BUSINESS_TIMEZONE=Africa/Lagos
# Sandbox card gateway for the storefront (signed webhooks). Defaults to on outside production and cannot be enabled in production.
# PAYMENT_TEST_ENABLED=true
# PAYMENT_TEST_SECRET=at-least-16-characters

# --- Sign-in security ---
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts staff authenticator-app secrets. Required in production;
# development and tests use a built-in key. Changing it means every staff member sets up their authenticator again.
# TWO_FACTOR_KEY=

# --- Email (password-reset links) ---
# Public addresses of the apps, used in email links (https in production).
BACKOFFICE_URL=http://localhost:5173
STOREFRONT_URL=http://localhost:5174
# Without SMTP_HOST, emails are written as text files to MAIL_OUTBOX_DIR (open one to follow a reset link).
# SMTP is required in production. Port 587 uses STARTTLS (required); 465 uses TLS.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Rhoyards <no-reply@example.com>"
MAIL_OUTBOX_DIR=./storage/outbox

# --- Running several API instances ---
# Rate-limit counters: "database" (shared by every instance; the production default) or "memory" (one process).
# RATE_LIMIT_STORE=database

# Initial owner account created by `npm run db:seed` (at first sign-in they set up an authenticator app and change the password).
# SEED_OWNER_EMAIL=owner@example.com
# SEED_OWNER_PASSWORD=<at least 10 characters>

# Never set ?schema=... on the pooled DATABASE_URL to share one database between environments.
