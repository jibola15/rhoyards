// Rhoyards database schema (PostgreSQL on Neon).
// Conventions: UUID primary keys, snake_case tables/columns, timestamptz, NUMERIC for money.
// CHECK constraints and triggers that Prisma cannot express live in the migration SQL — see docs/DATABASE.md.

generator client {
  provider        = "prisma-client-js"
  // Loads relations with SQL joins: one round trip per query, important with a remote Neon database.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Identity & security ─────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique
  passwordHash       String     @map("password_hash")
  fullName           String     @map("full_name")
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt  DateTime   @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdById        String?    @map("created_by_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy      User?          @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdUsers   User[]         @relation("UserCreatedBy")
  roles          UserRole[]     @relation("UserRoles")
  rolesAssigned  UserRole[]     @relation("UserRoleAssignedBy")
  locations      UserLocation[]
  sessions       Session[]
  auditLogs      AuditLog[]
  journalCreated JournalEntry[] @relation("JournalCreatedBy")
  journalPosted  JournalEntry[] @relation("JournalPostedBy")
  settings       Setting[]

  filesUploaded        File[]
  productsCreated      Product[]
  stockMovements       StockMovement[]
  adjustmentsCreated   StockAdjustment[] @relation("AdjustmentCreatedBy")
  adjustmentsPosted    StockAdjustment[] @relation("AdjustmentPostedBy")
  adjustmentsCancelled StockAdjustment[] @relation("AdjustmentCancelledBy")
  transfersCreated     StockTransfer[]   @relation("TransferCreatedBy")
  transfersDispatched  StockTransfer[]   @relation("TransferDispatchedBy")
  transfersReceived    StockTransfer[]   @relation("TransferReceivedBy")
  transfersCancelled   StockTransfer[]   @relation("TransferCancelledBy")

  purchaseOrdersCreated  PurchaseOrder[]   @relation("PoCreatedBy")
  purchaseOrdersApproved PurchaseOrder[]   @relation("PoApprovedBy")
  purchaseOrdersEnded    PurchaseOrder[]   @relation("PoEndedBy")
  receiptsCreated        GoodsReceipt[]    @relation("GrnCreatedBy")
  receiptsPosted         GoodsReceipt[]    @relation("GrnPostedBy")
  receiptsCancelled      GoodsReceipt[]    @relation("GrnCancelledBy")
  invoicesCreated        SupplierInvoice[] @relation("InvCreatedBy")
  invoicesPosted         SupplierInvoice[] @relation("InvPostedBy")
  invoicesCancelled      SupplierInvoice[] @relation("InvCancelledBy")
  supplierPayments       SupplierPayment[]
  returnsCreated         PurchaseReturn[]  @relation("RetCreatedBy")
  returnsPosted          PurchaseReturn[]  @relation("RetPostedBy")
  returnsCancelled       PurchaseReturn[]  @relation("RetCancelledBy")
  shiftsWorked           CashierShift[]    @relation("ShiftCashier")
  shiftsClosed           CashierShift[]    @relation("ShiftClosedBy")
  salesRung              Sale[]            @relation("SaleCashier")
  discountsApproved      Sale[]            @relation("SaleDiscountApprover")

  @@index([status])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique
  module      String
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user       User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model UserLocation {
  userId     String @map("user_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([userId, locationId])
  @@index([locationId])
  @@map("user_locations")
}

enum SessionRealm {
  STAFF
  CUSTOMER
}

model Session {
  id            String       @id @default(uuid()) @db.Uuid
  tokenHash     String       @unique @map("token_hash")
  realm         SessionRealm
  userId        String?      @map("user_id") @db.Uuid
  csrfToken     String       @map("csrf_token")
  ip            String?
  userAgent     String?      @map("user_agent")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt DateTime     @map("idle_expires_at") @db.Timestamptz(3)
  expiresAt     DateTime     @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?    @map("revoked_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Append-only (enforced by trigger). Written in the same transaction as the change it records.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ip          String?
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ───────────────────────────── Settings & configuration ─────────────────────────────

model Setting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("settings")
}

enum TaxKind {
  STANDARD
  ZERO_RATED
  EXEMPT
}

model TaxRate {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  name            String
  kind            TaxKind
  /// Percentage, e.g. 7.5000. CHECK: 0–100, and 0 unless STANDARD.
  rate            Decimal  @db.Decimal(7, 4)
  outputAccountId String?  @map("output_account_id") @db.Uuid
  inputAccountId  String?  @map("input_account_id") @db.Uuid
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  outputAccount Account?              @relation("TaxOutputAccount", fields: [outputAccountId], references: [id], onDelete: Restrict)
  inputAccount  Account?              @relation("TaxInputAccount", fields: [inputAccountId], references: [id], onDelete: Restrict)
  products      Product[]
  poLines       PurchaseOrderLine[]
  grnLines      GoodsReceiptLine[]
  invoiceLines  SupplierInvoiceLine[]
  saleItems     SaleItem[]

  @@map("tax_rates")
}

model DocumentSequence {
  key       String @id
  prefix    String
  nextValue Int    @default(1) @map("next_value")
  padding   Int    @default(6)

  @@map("document_sequences")
}

model IdempotencyKey {
  id          String   @id @default(uuid()) @db.Uuid
  scope       String
  key         String
  requestHash String   @map("request_hash")
  statusCode  Int?     @map("status_code")
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ───────────────────────────── Locations ─────────────────────────────

enum LocationType {
  STORE
  WAREHOUSE
}

model Location {
  id                 String       @id @default(uuid()) @db.Uuid
  code               String       @unique
  name               String
  type               LocationType
  isPosEnabled       Boolean      @default(false) @map("is_pos_enabled")
  isOnlineFulfilment Boolean      @default(false) @map("is_online_fulfilment")
  address            String?
  phone              String?
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  users           UserLocation[]
  journalLines    JournalLine[]
  balances        InventoryBalance[]
  batches         InventoryBatch[]
  movements       StockMovement[]
  adjustments     StockAdjustment[]
  transfersOut    StockTransfer[]    @relation("TransferFrom")
  transfersIn     StockTransfer[]    @relation("TransferTo")
  purchaseOrders  PurchaseOrder[]
  receipts        GoodsReceipt[]
  purchaseReturns PurchaseReturn[]
  registers       Register[]
  sales           Sale[]

  @@map("locations")
}

// ───────────────────────────── Accounting core ─────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model Account {
  id          String      @id @default(uuid()) @db.Uuid
  code        String      @unique
  name        String
  type        AccountType
  subtype     String?
  description String?
  parentId    String?     @map("parent_id") @db.Uuid
  isPostable  Boolean     @default(true) @map("is_postable")
  /// Stable key used by posting rules (e.g. INVENTORY, AR, VAT_OUTPUT). Never reused.
  systemKey   String?     @unique @map("system_key")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent           Account?              @relation("AccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children         Account[]             @relation("AccountTree")
  journalLines     JournalLine[]
  taxOutputFor     TaxRate[]             @relation("TaxOutputAccount")
  taxInputFor      TaxRate[]             @relation("TaxInputAccount")
  invoiceLines     SupplierInvoiceLine[]
  supplierPayments SupplierPayment[]
  paymentMethods   PaymentMethod[]

  @@index([type])
  @@map("accounts")
}

enum PeriodStatus {
  OPEN
  CLOSED
}

model FiscalYear {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique
  startDate DateTime     @map("start_date") @db.Date
  endDate   DateTime     @map("end_date") @db.Date
  status     PeriodStatus @default(OPEN)
  closedAt   DateTime?    @map("closed_at") @db.Timestamptz(3)
  closedById String?      @map("closed_by_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  periods AccountingPeriod[]

  @@map("fiscal_years")
}

model AccountingPeriod {
  id           String       @id @default(uuid()) @db.Uuid
  fiscalYearId String       @map("fiscal_year_id") @db.Uuid
  name         String
  startDate    DateTime     @map("start_date") @db.Date
  endDate      DateTime     @map("end_date") @db.Date
  status       PeriodStatus @default(OPEN)
  closedAt     DateTime?    @map("closed_at") @db.Timestamptz(3)
  closedById   String?      @map("closed_by_id") @db.Uuid

  fiscalYear FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  entries    JournalEntry[]

  @@unique([fiscalYearId, startDate])
  @@index([startDate, endDate])
  @@map("accounting_periods")
}

enum JournalStatus {
  DRAFT
  POSTED
}

/// POSTED entries are immutable (trigger). Corrections are made by reversal (reversal_of_id is UNIQUE).
model JournalEntry {
  id           String        @id @default(uuid()) @db.Uuid
  number       String?       @unique
  entryDate    DateTime      @map("entry_date") @db.Date
  periodId     String        @map("period_id") @db.Uuid
  sourceType   String        @map("source_type")
  sourceId     String?       @map("source_id")
  /// Idempotency key for automatic postings, e.g. "SALE:<id>". UNIQUE prevents double posting.
  postingKey   String?       @unique @map("posting_key")
  description  String
  status       JournalStatus @default(DRAFT)
  reversalOfId String?       @unique @map("reversal_of_id") @db.Uuid
  totalDebit   Decimal       @default(0) @map("total_debit") @db.Decimal(18, 2)
  totalCredit  Decimal       @default(0) @map("total_credit") @db.Decimal(18, 2)
  createdById  String        @map("created_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  postedById   String?       @map("posted_by_id") @db.Uuid
  postedAt     DateTime?     @map("posted_at") @db.Timestamptz(3)

  period     AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  reversalOf JournalEntry?    @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy JournalEntry?    @relation("JournalReversal")
  createdBy  User             @relation("JournalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy   User?            @relation("JournalPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  lines      JournalLine[]

  @@index([entryDate])
  @@index([status, entryDate])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

/// CHECK: debit >= 0, credit >= 0, exactly one of them non-zero.
model JournalLine {
  id         String  @id @default(uuid()) @db.Uuid
  entryId    String  @map("entry_id") @db.Uuid
  lineNo     Int     @map("line_no")
  accountId  String  @map("account_id") @db.Uuid
  debit      Decimal @default(0) @db.Decimal(18, 2)
  credit     Decimal @default(0) @db.Decimal(18, 2)
  memo       String?
  locationId String? @map("location_id") @db.Uuid

  entry    JournalEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  account  Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  location Location?    @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([entryId, lineNo])
  @@index([accountId])
  @@map("journal_lines")
}

// ───────────────────────────── Files ─────────────────────────────

enum FileVisibility {
  PUBLIC
  PRIVATE
}

/// Uploaded files. Images are re-encoded on upload; the stored bytes never come straight from the client.
model File {
  id           String         @id @default(uuid()) @db.Uuid
  storageKey   String         @unique @map("storage_key")
  originalName String         @map("original_name")
  mimeType     String         @map("mime_type")
  sizeBytes    Int            @map("size_bytes")
  sha256       String
  width        Int?
  height       Int?
  visibility   FileVisibility @default(PRIVATE)
  uploadedById String         @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  uploadedBy    User           @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  productImages ProductImage[]

  @@map("files")
}

// ───────────────────────────── Catalogue ─────────────────────────────

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("brands")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Unit {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique
  name           String
  allowsFraction Boolean  @default(false) @map("allows_fraction")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  products       Product[]
  volumeVariants ProductVariant[]

  @@map("units")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  DISCONTINUED
}

model Product {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  slug            String        @unique
  brandId         String?       @map("brand_id") @db.Uuid
  categoryId      String?       @map("category_id") @db.Uuid
  unitId          String        @map("unit_id") @db.Uuid
  taxRateId       String        @map("tax_rate_id") @db.Uuid
  description     String?
  /// Expiry-tracked products are always batch-tracked (a batch carries the expiry date).
  isExpiryTracked Boolean       @default(false) @map("is_expiry_tracked")
  isBatchTracked  Boolean       @default(false) @map("is_batch_tracked")
  status          ProductStatus @default(ACTIVE)
  onlineVisible   Boolean       @default(false) @map("online_visible")
  archivedAt      DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdById     String        @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  brand     Brand?           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category  Category?        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit      Unit             @relation(fields: [unitId], references: [id], onDelete: Restrict)
  taxRate   TaxRate          @relation(fields: [taxRateId], references: [id], onDelete: Restrict)
  createdBy User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  variants  ProductVariant[]
  images    ProductImage[]

  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

enum VariantStatus {
  ACTIVE
  DISCONTINUED
}

/// Every sellable item. stock_qty / stock_value are company-wide totals maintained by the inventory
/// engine (moving weighted-average cost: avg_cost = stock_value / stock_qty).
model ProductVariant {
  id             String        @id @default(uuid()) @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  sku            String        @unique
  name           String
  shade          String?
  colour         String?
  tone           String?
  size           String?
  volumeValue    Decimal?      @map("volume_value") @db.Decimal(12, 3)
  volumeUnitId   String?       @map("volume_unit_id") @db.Uuid
  sellingPrice   Decimal       @map("selling_price") @db.Decimal(18, 2)
  compareAtPrice Decimal?      @map("compare_at_price") @db.Decimal(18, 2)
  /// Reference cost for planning only; stock valuation uses avg_cost.
  standardCost   Decimal?      @map("standard_cost") @db.Decimal(18, 4)
  avgCost        Decimal       @default(0) @map("avg_cost") @db.Decimal(18, 4)
  stockQty       Decimal       @default(0) @map("stock_qty") @db.Decimal(14, 3)
  stockValue     Decimal       @default(0) @map("stock_value") @db.Decimal(18, 2)
  reorderLevel   Decimal       @default(0) @map("reorder_level") @db.Decimal(14, 3)
  reorderQty     Decimal       @default(0) @map("reorder_qty") @db.Decimal(14, 3)
  status         VariantStatus @default(ACTIVE)
  archivedAt     DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  product         Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  volumeUnit      Unit?                 @relation(fields: [volumeUnitId], references: [id], onDelete: Restrict)
  barcodes        VariantBarcode[]
  images          ProductImage[]
  balances        InventoryBalance[]
  batches         InventoryBatch[]
  movements       StockMovement[]
  adjustmentLines StockAdjustmentLine[]
  transferLines   StockTransferLine[]
  poLines         PurchaseOrderLine[]
  grnLines        GoodsReceiptLine[]
  invoiceLines    SupplierInvoiceLine[]
  returnLines     PurchaseReturnLine[]
  saleItems       SaleItem[]

  @@index([productId])
  @@map("product_variants")
}

model VariantBarcode {
  id        String  @id @default(uuid()) @db.Uuid
  variantId String  @map("variant_id") @db.Uuid
  barcode   String  @unique
  isPrimary Boolean @default(false) @map("is_primary")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("variant_barcodes")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid
  fileId    String  @map("file_id") @db.Uuid
  altText   String? @map("alt_text")
  sortOrder Int     @default(0) @map("sort_order")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  file    File            @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@map("product_images")
}

// ───────────────────────────── Suppliers ─────────────────────────────

model Supplier {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique
  name             String
  contactName      String?  @map("contact_name")
  email            String?
  phone            String?
  address          String?
  taxId            String?  @map("tax_id")
  paymentTermsDays Int      @default(0) @map("payment_terms_days")
  notes            String?
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchaseOrders PurchaseOrder[]
  receipts       GoodsReceipt[]
  invoices       SupplierInvoice[]
  payments       SupplierPayment[]
  returns        PurchaseReturn[]

  @@index([name])
  @@map("suppliers")
}

// ───────────────────────────── Purchasing ─────────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id           String              @id @default(uuid()) @db.Uuid
  number       String              @unique
  supplierId   String              @map("supplier_id") @db.Uuid
  locationId   String              @map("location_id") @db.Uuid
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @map("order_date") @db.Date
  expectedDate DateTime?           @map("expected_date") @db.Date
  note         String?
  /// Net of VAT.
  subtotal     Decimal             @default(0) @db.Decimal(18, 2)
  taxTotal     Decimal             @default(0) @map("tax_total") @db.Decimal(18, 2)
  total        Decimal             @default(0) @db.Decimal(18, 2)
  createdById  String              @map("created_by_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  approvedById String?             @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?           @map("approved_at") @db.Timestamptz(3)
  /// Who closed or cancelled the order.
  endedById    String?             @map("ended_by_id") @db.Uuid
  endedAt      DateTime?           @map("ended_at") @db.Timestamptz(3)

  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  location   Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy  User                @relation("PoCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?               @relation("PoApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  endedBy    User?               @relation("PoEndedBy", fields: [endedById], references: [id], onDelete: Restrict)
  lines      PurchaseOrderLine[]
  receipts   GoodsReceipt[]

  @@index([supplierId, createdAt])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id          String  @id @default(uuid()) @db.Uuid
  poId        String  @map("po_id") @db.Uuid
  lineNo      Int     @map("line_no")
  variantId   String  @map("variant_id") @db.Uuid
  qtyOrdered  Decimal @map("qty_ordered") @db.Decimal(14, 3)
  /// Maintained when goods receipts are posted. CHECK: ≤ qty_ordered.
  qtyReceived Decimal @default(0) @map("qty_received") @db.Decimal(14, 3)
  /// Excluding VAT.
  unitCost    Decimal @map("unit_cost") @db.Decimal(18, 4)
  taxRateId   String? @map("tax_rate_id") @db.Uuid
  /// Snapshot of the rate when the line was written.
  taxRate     Decimal @default(0) @map("tax_rate") @db.Decimal(7, 4)
  netAmount   Decimal @map("net_amount") @db.Decimal(18, 2)

  po       PurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Cascade)
  variant  ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  tax      TaxRate?           @relation(fields: [taxRateId], references: [id], onDelete: Restrict)
  grnLines GoodsReceiptLine[]

  @@unique([poId, lineNo])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id             String         @id @default(uuid()) @db.Uuid
  number         String         @unique
  supplierId     String         @map("supplier_id") @db.Uuid
  locationId     String         @map("location_id") @db.Uuid
  poId           String?        @map("po_id") @db.Uuid
  status         DocumentStatus @default(DRAFT)
  receivedDate   DateTime       @map("received_date") @db.Date
  /// Supplier's delivery note / waybill number.
  supplierRef    String?        @map("supplier_ref")
  note           String?
  totalValue     Decimal        @default(0) @map("total_value") @db.Decimal(18, 2)
  journalEntryId String?        @map("journal_entry_id") @db.Uuid
  createdById    String         @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  postedById     String?        @map("posted_by_id") @db.Uuid
  postedAt       DateTime?      @map("posted_at") @db.Timestamptz(3)
  cancelledById  String?        @map("cancelled_by_id") @db.Uuid
  cancelledAt    DateTime?      @map("cancelled_at") @db.Timestamptz(3)

  supplier    Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  location    Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  po          PurchaseOrder?     @relation(fields: [poId], references: [id], onDelete: Restrict)
  createdBy   User               @relation("GrnCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy    User?              @relation("GrnPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  cancelledBy User?              @relation("GrnCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  lines       GoodsReceiptLine[]
  returns     PurchaseReturn[]

  @@index([supplierId, receivedDate])
  @@index([status])
  @@map("goods_receipts")
}

/// Matching counters (qty_invoiced, grni_cleared, returns) change after posting; the received
/// quantity, cost and lot do not (trigger).
model GoodsReceiptLine {
  id                    String    @id @default(uuid()) @db.Uuid
  receiptId             String    @map("receipt_id") @db.Uuid
  lineNo                Int       @map("line_no")
  poLineId              String?   @map("po_line_id") @db.Uuid
  variantId             String    @map("variant_id") @db.Uuid
  qty                   Decimal   @db.Decimal(14, 3)
  /// Excluding VAT — the cost the stock is received at.
  unitCost              Decimal   @map("unit_cost") @db.Decimal(18, 4)
  taxRateId             String?   @map("tax_rate_id") @db.Uuid
  taxRate               Decimal   @default(0) @map("tax_rate") @db.Decimal(7, 4)
  lotNumber             String?   @map("lot_number")
  mfgDate               DateTime? @map("mfg_date") @db.Date
  expiryDate            DateTime? @map("expiry_date") @db.Date
  /// Received value (= GRNI credit), set on posting.
  value                 Decimal   @default(0) @db.Decimal(18, 2)
  qtyInvoiced           Decimal   @default(0) @map("qty_invoiced") @db.Decimal(14, 3)
  invoicedValue         Decimal   @default(0) @map("invoiced_value") @db.Decimal(18, 2)
  /// GRNI cleared by invoices and by returns of uninvoiced goods. Outstanding GRNI = value − grni_cleared.
  grniCleared           Decimal   @default(0) @map("grni_cleared") @db.Decimal(18, 2)
  qtyReturnedUninvoiced Decimal   @default(0) @map("qty_returned_uninvoiced") @db.Decimal(14, 3)
  qtyReturnedInvoiced   Decimal   @default(0) @map("qty_returned_invoiced") @db.Decimal(14, 3)

  receipt      GoodsReceipt          @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  poLine       PurchaseOrderLine?    @relation(fields: [poLineId], references: [id], onDelete: Restrict)
  variant      ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  tax          TaxRate?              @relation(fields: [taxRateId], references: [id], onDelete: Restrict)
  invoiceLines SupplierInvoiceLine[]
  returnLines  PurchaseReturnLine[]

  @@unique([receiptId, lineNo])
  @@index([poLineId])
  @@map("goods_receipt_lines")
}

enum SupplierInvoiceStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model SupplierInvoice {
  id             String                @id @default(uuid()) @db.Uuid
  number         String                @unique
  supplierId     String                @map("supplier_id") @db.Uuid
  /// The supplier's own invoice number. UNIQUE per supplier: the same invoice cannot be entered twice.
  supplierRef    String                @map("supplier_ref")
  invoiceDate    DateTime              @map("invoice_date") @db.Date
  dueDate        DateTime              @map("due_date") @db.Date
  status         SupplierInvoiceStatus @default(DRAFT)
  subtotal       Decimal               @default(0) @db.Decimal(18, 2)
  taxTotal       Decimal               @default(0) @map("tax_total") @db.Decimal(18, 2)
  total          Decimal               @default(0) @db.Decimal(18, 2)
  amountPaid     Decimal               @default(0) @map("amount_paid") @db.Decimal(18, 2)
  note           String?
  journalEntryId String?               @map("journal_entry_id") @db.Uuid
  createdById    String                @map("created_by_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  postedById     String?               @map("posted_by_id") @db.Uuid
  postedAt       DateTime?             @map("posted_at") @db.Timestamptz(3)
  cancelledById  String?               @map("cancelled_by_id") @db.Uuid
  cancelledAt    DateTime?             @map("cancelled_at") @db.Timestamptz(3)

  supplier    Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy   User                        @relation("InvCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy    User?                       @relation("InvPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  cancelledBy User?                       @relation("InvCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  lines       SupplierInvoiceLine[]
  allocations SupplierPaymentAllocation[]

  @@unique([supplierId, supplierRef])
  @@index([status, dueDate])
  @@map("supplier_invoices")
}

/// Either matches a goods-receipt line (stock) or charges an account directly (e.g. delivery, services).
model SupplierInvoiceLine {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  lineNo      Int     @map("line_no")
  grnLineId   String? @map("grn_line_id") @db.Uuid
  variantId   String? @map("variant_id") @db.Uuid
  accountId   String? @map("account_id") @db.Uuid
  description String
  qty         Decimal @db.Decimal(14, 3)
  /// Excluding VAT, as charged by the supplier.
  unitCost    Decimal @map("unit_cost") @db.Decimal(18, 4)
  taxRateId   String? @map("tax_rate_id") @db.Uuid
  taxRate     Decimal @default(0) @map("tax_rate") @db.Decimal(7, 4)
  netAmount   Decimal @map("net_amount") @db.Decimal(18, 2)
  taxAmount   Decimal @map("tax_amount") @db.Decimal(18, 2)

  invoice SupplierInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  grnLine GoodsReceiptLine? @relation(fields: [grnLineId], references: [id], onDelete: Restrict)
  variant ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  account Account?          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  tax     TaxRate?          @relation(fields: [taxRateId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, lineNo])
  @@index([grnLineId])
  @@map("supplier_invoice_lines")
}

/// Posted on creation and immutable (trigger). Amounts not allocated to invoices remain a credit with the supplier.
model SupplierPayment {
  id             String   @id @default(uuid()) @db.Uuid
  number         String   @unique
  supplierId     String   @map("supplier_id") @db.Uuid
  paymentDate    DateTime @map("payment_date") @db.Date
  amount         Decimal  @db.Decimal(18, 2)
  unallocated    Decimal  @db.Decimal(18, 2)
  /// The cash or bank account paid from.
  accountId      String   @map("account_id") @db.Uuid
  reference      String?
  note           String?
  journalEntryId String   @map("journal_entry_id") @db.Uuid
  createdById    String   @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  supplier    Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  account     Account                     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdBy   User                        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  allocations SupplierPaymentAllocation[]

  @@index([supplierId, paymentDate])
  @@map("supplier_payments")
}

model SupplierPaymentAllocation {
  id        String  @id @default(uuid()) @db.Uuid
  paymentId String  @map("payment_id") @db.Uuid
  invoiceId String  @map("invoice_id") @db.Uuid
  amount    Decimal @db.Decimal(18, 2)

  payment SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("supplier_payment_allocations")
}

model PurchaseReturn {
  id             String         @id @default(uuid()) @db.Uuid
  number         String         @unique
  supplierId     String         @map("supplier_id") @db.Uuid
  locationId     String         @map("location_id") @db.Uuid
  receiptId      String         @map("receipt_id") @db.Uuid
  status         DocumentStatus @default(DRAFT)
  returnDate     DateTime       @map("return_date") @db.Date
  reason         String?
  note           String?
  /// Debit-note value owed back by the supplier (invoiced quantities, incl. VAT). Uninvoiced returns only clear GRNI.
  creditTotal    Decimal        @default(0) @map("credit_total") @db.Decimal(18, 2)
  journalEntryId String?        @map("journal_entry_id") @db.Uuid
  createdById    String         @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  postedById     String?        @map("posted_by_id") @db.Uuid
  postedAt       DateTime?      @map("posted_at") @db.Timestamptz(3)
  cancelledById  String?        @map("cancelled_by_id") @db.Uuid
  cancelledAt    DateTime?      @map("cancelled_at") @db.Timestamptz(3)

  supplier    Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  location    Location             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  receipt     GoodsReceipt         @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  createdBy   User                 @relation("RetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy    User?                @relation("RetPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  cancelledBy User?                @relation("RetCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  lines       PurchaseReturnLine[]

  @@index([supplierId, returnDate])
  @@map("purchase_returns")
}

model PurchaseReturnLine {
  id          String  @id @default(uuid()) @db.Uuid
  returnId    String  @map("return_id") @db.Uuid
  lineNo      Int     @map("line_no")
  grnLineId   String  @map("grn_line_id") @db.Uuid
  variantId   String  @map("variant_id") @db.Uuid
  qty         Decimal @db.Decimal(14, 3)
  /// Set on posting: stock value removed (at average cost) and supplier credit for this line.
  stockValue  Decimal @default(0) @map("stock_value") @db.Decimal(18, 2)
  creditValue Decimal @default(0) @map("credit_value") @db.Decimal(18, 2)

  purchaseReturn PurchaseReturn   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  grnLine        GoodsReceiptLine @relation(fields: [grnLineId], references: [id], onDelete: Restrict)
  variant        ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([returnId, lineNo])
  @@map("purchase_return_lines")
}

// ───────────────────────────── Inventory ─────────────────────────────

/// Quantity per variant per location. Changed only by the inventory engine, under row locks.
model InventoryBalance {
  id          String   @id @default(uuid()) @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  locationId  String   @map("location_id") @db.Uuid
  qtyOnHand   Decimal  @default(0) @map("qty_on_hand") @db.Decimal(14, 3)
  qtyReserved Decimal  @default(0) @map("qty_reserved") @db.Decimal(14, 3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([variantId, locationId])
  @@index([locationId])
  @@map("inventory_balances")
}

enum BatchStatus {
  AVAILABLE
  QUARANTINE
}

/// Lots of batch/expiry-tracked variants. Used for FEFO picking and expiry control; carries no cost.
model InventoryBatch {
  id         String      @id @default(uuid()) @db.Uuid
  variantId  String      @map("variant_id") @db.Uuid
  locationId String      @map("location_id") @db.Uuid
  lotNumber  String      @map("lot_number")
  mfgDate    DateTime?   @map("mfg_date") @db.Date
  expiryDate DateTime?   @map("expiry_date") @db.Date
  qtyOnHand  Decimal     @default(0) @map("qty_on_hand") @db.Decimal(14, 3)
  status     BatchStatus @default(AVAILABLE)
  receivedAt DateTime    @default(now()) @map("received_at") @db.Timestamptz(3)

  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location  Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  movements StockMovement[]

  @@unique([variantId, locationId, lotNumber])
  @@index([variantId, locationId, expiryDate])
  @@index([expiryDate])
  @@map("inventory_batches")
}

enum StockMovementType {
  OPENING
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  SALE
  SALE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  WRITE_OFF
  TRANSFER_OUT
  TRANSFER_IN
}

/// The stock ledger. Append-only (trigger). Every quantity change has exactly one movement per batch touched.
model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  variantId    String            @map("variant_id") @db.Uuid
  locationId   String            @map("location_id") @db.Uuid
  batchId      String?           @map("batch_id") @db.Uuid
  type         StockMovementType
  /// Signed: positive in, negative out.
  qtyChange    Decimal           @map("qty_change") @db.Decimal(14, 3)
  unitCost     Decimal           @map("unit_cost") @db.Decimal(18, 4)
  /// Signed value moved; Σ total_cost per variant = its stock_value.
  totalCost    Decimal           @map("total_cost") @db.Decimal(18, 2)
  /// Location balance after this movement.
  qtyAfter     Decimal           @map("qty_after") @db.Decimal(14, 3)
  avgCostAfter Decimal           @map("avg_cost_after") @db.Decimal(18, 4)
  sourceType   String            @map("source_type")
  sourceId     String            @map("source_id")
  sourceLineId String?           @map("source_line_id")
  note         String?
  createdById  String            @map("created_by_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location  Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  batch     InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  createdBy User            @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
  @@index([locationId, createdAt])
  @@index([sourceType, sourceId])
  @@map("stock_movements")
}

enum DocumentStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum AdjustmentReason {
  OPENING_STOCK
  STOCK_COUNT
  DAMAGE
  EXPIRY
  THEFT
  OTHER
}

model StockAdjustment {
  id             String           @id @default(uuid()) @db.Uuid
  number         String           @unique
  locationId     String           @map("location_id") @db.Uuid
  reason         AdjustmentReason
  note           String?
  status         DocumentStatus   @default(DRAFT)
  journalEntryId String?          @map("journal_entry_id") @db.Uuid
  createdById    String           @map("created_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  postedById     String?          @map("posted_by_id") @db.Uuid
  postedAt       DateTime?        @map("posted_at") @db.Timestamptz(3)
  cancelledById  String?          @map("cancelled_by_id") @db.Uuid
  cancelledAt    DateTime?        @map("cancelled_at") @db.Timestamptz(3)

  location    Location              @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy   User                  @relation("AdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy    User?                 @relation("AdjustmentPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  cancelledBy User?                 @relation("AdjustmentCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  lines       StockAdjustmentLine[]

  @@index([status, createdAt])
  @@map("stock_adjustments")
}

model StockAdjustmentLine {
  id           String    @id @default(uuid()) @db.Uuid
  adjustmentId String    @map("adjustment_id") @db.Uuid
  lineNo       Int       @map("line_no")
  variantId    String    @map("variant_id") @db.Uuid
  /// Signed, non-zero.
  qtyChange    Decimal   @map("qty_change") @db.Decimal(14, 3)
  /// Required for increases; decreases are valued at the moving average when posted.
  unitCost     Decimal?  @map("unit_cost") @db.Decimal(18, 4)
  /// Increases of batch-tracked items: the lot to add to. Decreases: optional lot to take from (else FEFO).
  lotNumber    String?   @map("lot_number")
  mfgDate      DateTime? @map("mfg_date") @db.Date
  expiryDate   DateTime? @map("expiry_date") @db.Date
  note         String?

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  variant    ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([adjustmentId, lineNo])
  @@map("stock_adjustment_lines")
}

enum TransferStatus {
  DRAFT
  DISPATCHED
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id             String         @id @default(uuid()) @db.Uuid
  number         String         @unique
  fromLocationId String         @map("from_location_id") @db.Uuid
  toLocationId   String         @map("to_location_id") @db.Uuid
  status         TransferStatus @default(DRAFT)
  note           String?
  createdById    String         @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  dispatchedById String?        @map("dispatched_by_id") @db.Uuid
  dispatchedAt   DateTime?      @map("dispatched_at") @db.Timestamptz(3)
  receivedById   String?        @map("received_by_id") @db.Uuid
  receivedAt     DateTime?      @map("received_at") @db.Timestamptz(3)
  cancelledById  String?        @map("cancelled_by_id") @db.Uuid
  cancelledAt    DateTime?      @map("cancelled_at") @db.Timestamptz(3)

  fromLocation Location            @relation("TransferFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   Location            @relation("TransferTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  createdBy    User                @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  dispatchedBy User?               @relation("TransferDispatchedBy", fields: [dispatchedById], references: [id], onDelete: Restrict)
  receivedBy   User?               @relation("TransferReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  cancelledBy  User?               @relation("TransferCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  lines        StockTransferLine[]

  @@index([status, createdAt])
  @@map("stock_transfers")
}

model StockTransferLine {
  id               String  @id @default(uuid()) @db.Uuid
  transferId       String  @map("transfer_id") @db.Uuid
  lineNo           Int     @map("line_no")
  variantId        String  @map("variant_id") @db.Uuid
  qty              Decimal @db.Decimal(14, 3)
  /// Lots picked (FEFO) at dispatch, recreated at the destination on receipt.
  batchAllocations Json?   @map("batch_allocations")

  transfer StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([transferId, lineNo])
  @@map("stock_transfer_lines")
}

// ───────────────────────────── Customers ─────────────────────────────

enum CustomerType {
  RETAIL
  WHOLESALE
}

model Customer {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  name        String
  type        CustomerType @default(RETAIL)
  phone       String?
  email       String?
  address     String?
  /// Credit (pay later) is allowed only when enabled and within the limit.
  allowCredit Boolean      @default(false) @map("allow_credit")
  creditLimit Decimal      @default(0) @map("credit_limit") @db.Decimal(18, 2)
  notes       String?
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  sales Sale[]

  @@index([name])
  @@index([phone])
  @@map("customers")
}

// ───────────────────────────── Point of sale ─────────────────────────────

enum PaymentMethodKind {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

/// How customers can pay. Each method debits its own ledger account (cash, card clearing, bank…).
model PaymentMethod {
  id                String            @id @default(uuid()) @db.Uuid
  code              String            @unique
  name              String
  kind              PaymentMethodKind
  accountId         String            @map("account_id") @db.Uuid
  requiresReference Boolean           @default(false) @map("requires_reference")
  availablePos      Boolean           @default(true) @map("available_pos")
  availableOnline   Boolean           @default(false) @map("available_online")
  isActive          Boolean           @default(true) @map("is_active")
  sortOrder         Int               @default(0) @map("sort_order")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  account  Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  payments SalePayment[]

  @@map("payment_methods")
}

model Register {
  id         String   @id @default(uuid()) @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  name       String
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  location Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  shifts   CashierShift[]
  sales    Sale[]

  @@unique([locationId, name])
  @@map("registers")
}

enum ShiftStatus {
  OPEN
  CLOSED
}

/// At most one OPEN shift per register and per cashier (partial unique indexes in SQL).
model CashierShift {
  id             String      @id @default(uuid()) @db.Uuid
  number         String      @unique
  registerId     String      @map("register_id") @db.Uuid
  cashierId      String      @map("cashier_id") @db.Uuid
  status         ShiftStatus @default(OPEN)
  openedAt       DateTime    @default(now()) @map("opened_at") @db.Timestamptz(3)
  openingFloat   Decimal     @map("opening_float") @db.Decimal(18, 2)
  closedAt       DateTime?   @map("closed_at") @db.Timestamptz(3)
  closedById     String?     @map("closed_by_id") @db.Uuid
  /// Opening float + cash taken − change given, computed at close.
  expectedCash   Decimal?    @map("expected_cash") @db.Decimal(18, 2)
  countedCash    Decimal?    @map("counted_cash") @db.Decimal(18, 2)
  variance       Decimal?    @db.Decimal(18, 2)
  closeNote      String?     @map("close_note")
  journalEntryId String?     @map("journal_entry_id") @db.Uuid

  register Register @relation(fields: [registerId], references: [id], onDelete: Restrict)
  cashier  User     @relation("ShiftCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  closedBy User?    @relation("ShiftClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  sales    Sale[]

  @@index([registerId, openedAt])
  @@map("cashier_shifts")
}

enum SaleStatus {
  SUSPENDED
  COMPLETED
}

enum SaleChannel {
  POS
  ONLINE
}

/// One table for every sale, in store or online, so revenue and channel reporting read one source.
/// COMPLETED sales are immutable (trigger); corrections are returns (Phase 8).
model Sale {
  id                   String      @id @default(uuid()) @db.Uuid
  /// Assigned when the sale is completed (suspended sales have none).
  number               String?     @unique
  channel              SaleChannel @default(POS)
  status               SaleStatus
  locationId           String      @map("location_id") @db.Uuid
  registerId           String?     @map("register_id") @db.Uuid
  shiftId              String?     @map("shift_id") @db.Uuid
  customerId           String?     @map("customer_id") @db.Uuid
  cashierId            String      @map("cashier_id") @db.Uuid
  /// Snapshot of the VAT pricing mode used.
  pricesIncludeTax     Boolean     @map("prices_include_tax")
  /// Σ line amounts before discount, in shelf-price terms.
  grossTotal           Decimal     @default(0) @map("gross_total") @db.Decimal(18, 2)
  discountTotal        Decimal     @default(0) @map("discount_total") @db.Decimal(18, 2)
  /// Net of VAT, after discount — the revenue.
  subtotal             Decimal     @default(0) @db.Decimal(18, 2)
  taxTotal             Decimal     @default(0) @map("tax_total") @db.Decimal(18, 2)
  /// What the customer pays.
  total                Decimal     @default(0) @db.Decimal(18, 2)
  amountPaid           Decimal     @default(0) @map("amount_paid") @db.Decimal(18, 2)
  changeGiven          Decimal     @default(0) @map("change_given") @db.Decimal(18, 2)
  /// Left on the customer's account (credit sale).
  balanceDue           Decimal     @default(0) @map("balance_due") @db.Decimal(18, 2)
  costTotal            Decimal     @default(0) @map("cost_total") @db.Decimal(18, 2)
  discountApprovedById String?     @map("discount_approved_by_id") @db.Uuid
  idempotencyKey       String?     @unique @map("idempotency_key")
  journalEntryId       String?     @map("journal_entry_id") @db.Uuid
  note                 String?
  completedAt          DateTime?   @map("completed_at") @db.Timestamptz(3)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  location           Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  register           Register?     @relation(fields: [registerId], references: [id], onDelete: Restrict)
  shift              CashierShift? @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  customer           Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cashier            User          @relation("SaleCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  discountApprovedBy User?         @relation("SaleDiscountApprover", fields: [discountApprovedById], references: [id], onDelete: Restrict)
  items              SaleItem[]
  payments           SalePayment[]

  @@index([status, completedAt])
  @@index([shiftId])
  @@index([customerId])
  @@index([locationId, completedAt])
  @@map("sales")
}

model SaleItem {
  id             String  @id @default(uuid()) @db.Uuid
  saleId         String  @map("sale_id") @db.Uuid
  lineNo         Int     @map("line_no")
  variantId      String  @map("variant_id") @db.Uuid
  /// Snapshots, so receipts and reports never change when the catalogue does.
  sku            String
  description    String
  qty            Decimal @db.Decimal(14, 3)
  /// Shelf price per unit (VAT-inclusive or exclusive per the sale's pricing mode).
  unitPrice      Decimal @map("unit_price") @db.Decimal(18, 2)
  /// The catalogue price when sold, to show overrides.
  listPrice      Decimal @map("list_price") @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(18, 2)
  taxRateId      String? @map("tax_rate_id") @db.Uuid
  taxRate        Decimal @default(0) @map("tax_rate") @db.Decimal(7, 4)
  netAmount      Decimal @map("net_amount") @db.Decimal(18, 2)
  taxAmount      Decimal @map("tax_amount") @db.Decimal(18, 2)
  lineTotal      Decimal @map("line_total") @db.Decimal(18, 2)
  /// Moving-average cost at the moment of sale (0 while suspended).
  unitCost       Decimal @default(0) @map("unit_cost") @db.Decimal(18, 4)
  costAmount     Decimal @default(0) @map("cost_amount") @db.Decimal(18, 2)
  qtyReturned    Decimal @default(0) @map("qty_returned") @db.Decimal(14, 3)

  sale    Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  tax     TaxRate?       @relation(fields: [taxRateId], references: [id], onDelete: Restrict)

  @@unique([saleId, lineNo])
  @@index([variantId])
  @@map("sale_items")
}

model SalePayment {
  id              String   @id @default(uuid()) @db.Uuid
  saleId          String   @map("sale_id") @db.Uuid
  paymentMethodId String   @map("payment_method_id") @db.Uuid
  /// Applied to the sale (tendered − change).
  amount          Decimal  @db.Decimal(18, 2)
  tendered        Decimal? @db.Decimal(18, 2)
  changeGiven     Decimal  @default(0) @map("change_given") @db.Decimal(18, 2)
  reference       String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@map("sale_payments")
}
