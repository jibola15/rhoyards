{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "vercel-dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30,
      "includeFiles": "{node_modules/.prisma/client/**,node_modules/@prisma/client/**,node_modules/argon2/**,node_modules/@img/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/((?!assets/).*)", "destination": "/admin/index.html" },
    { "source": "/((?!assets/|admin/assets/|api/).*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/v1/internal/cron", "schedule": "0 3 * * *" }],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/(admin/)?assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
